<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Track -->
    <item android:id="@android:id/background">
        <shape>
            <solid android:color="@color/gray_100" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    
    <!-- Progress -->
    <item android:id="@android:id/progress">
        <scale android:scaleWidth="0.33"> <!-- 1/3 filled -->
             <shape>
                <solid android:color="@color/primaryColor" />
                <corners android:radius="4dp" />
            </shape>
        </scale>
    </item>
</layer-list>
<!-- Note: Just using a shape here might be easier than a progress drawable if static. 
But user probably wants it to look like the HTML: 
<div class="h-1.5 w-32 bg-slate-100 ... rounded-full">
   <div class="h-full bg-primary w-1/3 rounded-full ..."></div>
