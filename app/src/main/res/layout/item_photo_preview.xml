<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="8dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/img_photo_preview"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium"
         />

    <ImageView
        android:id="@+id/btn_delete_photo"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_margin="4dp"
        android:background="@drawable/bg_circle_shape"
        android:backgroundTint="#80000000"
        android:padding="4dp"
        android:src="@drawable/ic_close_small"
        app:layout_constraintEnd_toEndOf="@id/img_photo_preview"
        app:layout_constraintTop_toTopOf="@id/img_photo_preview"
        app:tint="@color/white" />

</androidx.constraintlayout.widget.ConstraintLayout>
