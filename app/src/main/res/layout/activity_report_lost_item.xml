<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:background="#FAFAFA"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back_ios"
            android:background="@drawable/bg_circle_shape"
            android:backgroundTint="#00000000"
            app:tint="@color/home_text_main"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Report Lost Item"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/home_text_main"
            android:gravity="center"
            android:layout_marginEnd="40dp"
            app:layout_constraintStart_toEndOf="@id/btnBack"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toTopOf="@id/footer">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Photo Upload -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Item Photo"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/home_text_main"
                android:layout_marginBottom="8dp"/>

            <FrameLayout
                android:id="@+id/btnUploadPhoto"
                android:layout_width="match_parent"
                android:layout_height="192dp"
                android:background="@drawable/bg_photo_upload_dashed"
                android:clickable="true"
                android:focusable="true">
                
                <LinearLayout
                    android:id="@+id/layoutUploadPlaceholder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_gravity="center">
                    
                    <FrameLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_circle_shape"
                        android:backgroundTint="#EBF5FF">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_add_a_photo"
                            android:layout_gravity="center"
                            app:tint="@color/primary"/>
                    </FrameLayout>
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Add Photo"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/home_text_main"
                        android:layout_marginTop="8dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tap to upload image"
                        android:textSize="12sp"
                        android:textColor="@color/home_text_secondary"/>
                </LinearLayout>

                <ImageView
                    android:id="@+id/ivSelectedPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    android:src="@null"/>
            </FrameLayout>

            <Space android:layout_width="match_parent" android:layout_height="24dp"/>

            <!-- What did you lose? -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="What did you lose?"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/home_text_main"
                android:layout_marginBottom="8dp"/>
            
            <EditText
                android:id="@+id/etItemName"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_input_field_default"
                android:hint="e.g. Blue Leather Wallet"
                android:paddingHorizontal="16dp"
                android:textSize="16sp"
                android:inputType="textCapWords"
                android:textColor="@color/home_text_main"
                android:textColorHint="@color/gray_400"/>

            <Space android:layout_width="match_parent" android:layout_height="24dp"/>

            <!-- Category -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Category"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/home_text_main"
                android:layout_marginBottom="8dp"/>
            
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_input_field_default">
                
                <Spinner
                    android:id="@+id/spinnerCategory"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:overlapAnchor="false"
                    android:paddingStart="8dp"
                    android:paddingEnd="40dp"
                    android:spinnerMode="dropdown"/>
                    
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_arrow_drop_down"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginEnd="16dp"
                    app:tint="@color/gray_500"/>
            </FrameLayout>

            <Space android:layout_width="match_parent" android:layout_height="24dp"/>

            <!-- Description -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom">
                
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Description"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/home_text_main"
                    android:layout_marginBottom="8dp"/>
                <TextView
                    android:id="@+id/tvDescriptionCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0/300"
                    android:textSize="12sp"
                    android:textColor="@color/gray_400"
                    android:layout_marginBottom="8dp"/>
            </LinearLayout>

            <EditText
                android:id="@+id/etDescription"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:background="@drawable/bg_input_field_default"
                android:hint="Provide specific details like color, brand, or unique contents..."
                android:gravity="top|start"
                android:padding="16dp"
                android:textSize="16sp"
                android:inputType="textMultiLine"
                android:maxLength="300"
                android:textColor="@color/home_text_main"
                android:textColorHint="@color/gray_400"/>

            <Space android:layout_width="match_parent" android:layout_height="24dp"/>

            <!-- Last Known Location -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Last Known Location"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/home_text_main"
                android:layout_marginBottom="8dp"/>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="56dp">
                
                <EditText
                    android:id="@+id/etLocation"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_input_field_default"
                    android:hint="e.g. Central Park Entrance"
                    android:paddingStart="16dp"
                    android:paddingEnd="48dp"
                    android:textSize="16sp"
                    android:inputType="text"
                    android:textColor="@color/home_text_main"
                    android:textColorHint="@color/gray_400"/>

                <ImageView
                    android:id="@+id/btnMyLocation"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_my_location"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginEnd="12dp"
                    app:tint="@color/primary"/>
            </FrameLayout>

            <Space android:layout_width="match_parent" android:layout_height="24dp"/>

            <!-- Date Lost -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Date Lost"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/home_text_main"
                android:layout_marginBottom="8dp"/>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="56dp">

                <EditText
                    android:id="@+id/etDateLost"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_input_field_default"
                    android:hint="mm/dd/yyyy"
                    android:paddingStart="16dp"
                    android:paddingEnd="48dp"
                    android:textSize="16sp"
                    android:focusable="false"
                    android:clickable="true"
                    android:inputType="none"
                    android:textColor="@color/home_text_main"
                    android:textColorHint="@color/gray_400"/>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_calendar"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginEnd="16dp"
                    app:tint="@color/home_text_main"/>
            </FrameLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Footer -->
    <FrameLayout
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmit"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Submit Report"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="@color/primary"
            app:cornerRadius="28dp"
            app:icon="@drawable/ic_send"
            app:iconGravity="textEnd"
            app:iconTint="@color/white"/>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
