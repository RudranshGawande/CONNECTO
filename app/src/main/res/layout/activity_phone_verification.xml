<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/white"
    android:fitsSystemWindows="true"
    tools:context=".PhoneVerificationActivity">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/white"
        android:elevation="4dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Back"
            app:tint="@android:color/black" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Phone Verification"
            android:textColor="@android:color/black"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <ImageView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:src="@drawable/ic_smartphone" 
                app:tint="@color/home_primary"
                tools:ignore="ContentDescription"
                tools:src="@android:drawable/ic_menu_call" />
                <!-- Assuming ic_smartphone exists or fallback to something standard if possible, but safer to use text/standard icons if unsure. 
                     I'll use a placeholder if needed, but for now assuming standard assets or I'll create a text description. -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Enter your phone number"
                android:textColor="@android:color/black"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="We will send a verification code to your new number."
                android:textColor="@android:color/darker_gray"
                android:textSize="14sp"
                android:gravity="center" />

            <!-- Phone Input Section -->
            <LinearLayout
                android:id="@+id/layoutPhoneInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="32dp">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Phone Number"
                    android:textSize="14sp"
                    android:textColor="#666666" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <Spinner
                        android:id="@+id/spinnerCountryCode"
                        android:layout_width="110dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_input_rounded"
                        android:layout_marginEnd="8dp"
                        android:entries="@array/country_codes"
                        android:gravity="center"
                        android:textAlignment="center"
                        android:spinnerMode="dropdown"
                        android:popupBackground="@android:color/white"/>

                    <EditText
                        android:id="@+id/etPhoneNumber"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="00000 00000"
                        android:inputType="phone"
                        android:padding="12dp"
                        android:background="@drawable/bg_input_rounded"
                        android:textColor="@android:color/black"
                        android:textColorHint="@android:color/darker_gray"/>
                </LinearLayout>

                <Button
                    android:id="@+id/btnSendCode"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Send Verification Code"
                    android:backgroundTint="@color/home_primary"
                    android:textColor="@android:color/white"
                    android:layout_marginTop="24dp"
                    app:cornerRadius="12dp" />

            </LinearLayout>

            <!-- OTP Input Section (Initially Hidden) -->
            <LinearLayout
                android:id="@+id/layoutOtpInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="32dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Enter Verification Code"
                    android:textSize="14sp"
                    android:textColor="#666666" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="6"
                    android:layout_marginTop="16dp"
                    android:gravity="center">

                    <EditText
                        android:id="@+id/etOtp1"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_input_rounded"
                        android:gravity="center"
                        android:inputType="number"
                        android:maxLength="1"
                        android:textSize="18sp"
                        android:textColor="@android:color/black" />
                    
                    <EditText
                        android:id="@+id/etOtp2"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_input_rounded"
                        android:gravity="center"
                        android:inputType="number"
                        android:maxLength="1"
                        android:textSize="18sp" 
                        android:textColor="@android:color/black"/>

                    <EditText
                        android:id="@+id/etOtp3"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_input_rounded"
                        android:gravity="center"
                        android:inputType="number"
                        android:maxLength="1"
                        android:textSize="18sp" 
                        android:textColor="@android:color/black"/>

                    <EditText
                        android:id="@+id/etOtp4"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_input_rounded"
                        android:gravity="center"
                        android:inputType="number"
                        android:maxLength="1"
                        android:textSize="18sp" 
                        android:textColor="@android:color/black"/>

                    <EditText
                        android:id="@+id/etOtp5"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_input_rounded"
                        android:gravity="center"
                        android:inputType="number"
                        android:maxLength="1"
                        android:textSize="18sp" 
                        android:textColor="@android:color/black"/>

                    <EditText
                        android:id="@+id/etOtp6"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input_rounded"
                        android:gravity="center"
                        android:inputType="number"
                        android:maxLength="1"
                        android:textSize="18sp"
                        android:textColor="@android:color/black"/>

                </LinearLayout>

                <Button
                    android:id="@+id/btnVerify"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Verify &amp; Update"
                    android:backgroundTint="@color/home_primary"
                    android:textColor="@android:color/white"
                    android:layout_marginTop="24dp"
                    app:cornerRadius="12dp" />
                    
                <TextView
                    android:id="@+id/tvResend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Resend Code"
                    android:textColor="@color/home_primary"
                    android:gravity="center"
                    android:padding="16dp"
                    android:textStyle="bold"/>

            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
