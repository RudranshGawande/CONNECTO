<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/bottomSheetContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_bottom_sheet_rounded"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- Drag Handle -->
        <View
            android:layout_width="48dp"
            android:layout_height="6dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_drag_handle_gray" />

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-black"
                android:text="Proximity Filter"
                android:textColor="@color/home_text_main"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/btnReset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="Reset"
                android:textColor="@color/home_primary"
                android:textSize="14sp" />
        </LinearLayout>
        
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/gray_200"
            android:layout_marginBottom="24dp"
            android:alpha="0.5"/>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="24dp">

                <!-- Near Me Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_white_rounded_16dp" 
                    android:padding="16dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:elevation="0dp"
                    android:backgroundTint="@color/gray_100"> 
                    <!-- Using gray_100 tint to simulate bg-gray-50 border effect or use a shape with border -->
                    
                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_circle_light_blue">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_my_location"
                            app:tint="@color/home_primary"/>
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Near Me"
                            android:fontFamily="sans-serif-bold"
                            android:textColor="@color/home_text_main"
                            android:textSize="16sp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Use current GPS location"
                            android:textColor="@color/gray_500"
                            android:textSize="12sp"/>
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchNearMe"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        app:trackTint="@color/selector_switch_track_blue"
                        app:thumbTint="@color/selector_switch_thumb_blue"/>
                </LinearLayout>

                <!-- Search Radius -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="32dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="bottom">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="SEARCH RADIUS"
                            android:fontFamily="sans-serif-bold"
                            android:textColor="@color/gray_500"
                            android:textSize="12sp"
                            android:letterSpacing="0.05"/>
                        <TextView
                            android:id="@+id/tvRadiusValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="15"
                            android:fontFamily="sans-serif-black"
                            android:textColor="@color/home_primary"
                            android:textSize="24sp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="km"
                            android:fontFamily="sans-serif-bold"
                            android:textColor="@color/home_primary"
                            android:textSize="14sp"
                            android:layout_marginStart="2dp"
                            android:layout_marginBottom="4dp"/>
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/seekBarRadius"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:max="50"
                        android:min="1"
                        android:progress="15"
                        android:progressDrawable="@drawable/progress_bar_custom" 
                        android:thumb="@drawable/thumb_seekbar_custom"
                        android:splitTrack="false"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1 KM"
                            android:textSize="10sp"
                            android:fontFamily="sans-serif-bold"
                            android:textColor="@color/gray_400"/>
                        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="50 KM"
                            android:textSize="10sp"
                            android:fontFamily="sans-serif-bold"
                            android:textColor="@color/gray_400"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Specific Location -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="32dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SPECIFIC LOCATION"
                        android:fontFamily="sans-serif-bold"
                        android:textColor="@color/gray_500"
                        android:textSize="12sp"
                        android:letterSpacing="0.05"
                        android:layout_marginBottom="12dp"/>

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        android:backgroundTint="#F3F4F6">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                            
                            <com.google.android.gms.maps.MapView
                                android:id="@+id/mapLiteView"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                app:liteMode="true"
                                app:mapType="normal"/>
                            
                            <!-- Center Pin (Visual only for lite mode context) -->
                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@drawable/ic_location_on_filled"
                                app:tint="@color/home_primary"
                                android:layout_gravity="center"
                                android:layout_marginBottom="16dp"/>

                            <!-- Set Location Button -->
                            <LinearLayout
                                android:id="@+id/btnSetLocation"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="bottom|end"
                                android:layout_margin="12dp"
                                android:background="@drawable/bg_white_rounded"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="8dp"
                                android:gravity="center"
                                android:clickable="true"
                                android:foreground="?attr/selectableItemBackground"
                                android:elevation="4dp">
                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:src="@drawable/ic_map_outline"
                                    app:tint="@color/home_primary"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Set Location"
                                    android:fontFamily="sans-serif-bold"
                                    android:textColor="@color/home_text_main"
                                    android:textSize="12sp"
                                    android:layout_marginStart="6dp"/>
                            </LinearLayout>
                        </FrameLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>
                
                <View android:layout_width="match_parent" android:layout_height="100dp"/>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="24dp"
            android:paddingTop="16dp"
            android:background="@drawable/bg_bottom_sheet_footer_blur"
            android:layout_marginTop="-20dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_rounded_16dp"
                android:backgroundTint="@color/gray_100"
                android:fontFamily="sans-serif-bold"
                android:text="Cancel"
                android:textAllCaps="false"
                android:textColor="@color/home_text_main"
                android:stateListAnimator="@null"
                android:layout_marginEnd="8dp"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnApplyFilters"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:background="@drawable/bg_button_primary_rounded"
                android:fontFamily="sans-serif-bold"
                android:text="Apply Filters"
                android:textColor="@color/white"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
