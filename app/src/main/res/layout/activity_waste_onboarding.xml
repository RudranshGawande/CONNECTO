<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:paddingHorizontal="24dp">

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Progress Dots (Top Left) -->
        <LinearLayout
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
             android:orientation="horizontal"
             android:gravity="center_vertical">
             <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/dot_inactive"
                android:backgroundTint="@color/gray_300"
                android:layout_marginEnd="6dp"/>
             <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/dot_inactive"
                android:backgroundTint="@color/gray_300"
                android:layout_marginEnd="6dp"/>
             <View
                android:layout_width="24dp"
                android:layout_height="6dp"
                android:background="@drawable/dot_active" 
                android:backgroundTint="@color/primaryColor"
                android:layout_marginEnd="6dp"/> <!-- Active Dash -->
             <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/dot_inactive"
                android:backgroundTint="@color/gray_300"/>
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btnSkip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Skip"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="@color/gray_500"
            android:padding="8dp"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <!-- Main Content Area -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/bottomSection"
        android:paddingBottom="8dp">

        <!-- Text Content Wrapper (Fixed Height elements) -->
        <LinearLayout
            android:id="@+id/textWrapper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_step_3_subtitle"
                android:textColor="@color/primaryColor"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginTop="16dp"
                android:textAllCaps="true"
                android:layout_gravity="center_horizontal"/>

            <TextView
                android:id="@+id/tvHeadline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_step_3_headline"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/onboarding_text_dark"
                android:gravity="center"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"
                android:fontFamily="sans-serif-black"/>

            <!-- Features List -->
            <LinearLayout
                android:id="@+id/featuresList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Item 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp"
                    android:gravity="center_vertical">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/circle_light_gray">
                         <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_calendar"
                            app:tint="@color/primaryColor"
                            android:layout_gravity="center"/>
                    </FrameLayout>
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/onboarding_step_3_title_1"
                            android:textStyle="bold"
                            android:textColor="@color/onboarding_text_dark"
                            android:textSize="14sp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/onboarding_step_3_desc_1"
                            android:textColor="@color/onboarding_text_gray"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Item 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp"
                    android:gravity="center_vertical">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/circle_light_gray">
                         <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_notification_important"
                            app:tint="@color/primaryColor"
                            android:layout_gravity="center"/>
                    </FrameLayout>
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/onboarding_step_3_title_2"
                            android:textStyle="bold"
                            android:textColor="@color/onboarding_text_dark"
                            android:textSize="14sp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/onboarding_step_3_desc_2"
                            android:textColor="@color/onboarding_text_gray"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Item 3 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/circle_light_gray">
                         <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_recycling"
                            app:tint="@color/primaryColor"
                            android:layout_gravity="center"/>
                    </FrameLayout>
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/onboarding_step_3_title_3"
                            android:textStyle="bold"
                            android:textColor="@color/onboarding_text_dark"
                            android:textSize="14sp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/onboarding_step_3_desc_3"
                            android:textColor="@color/onboarding_text_gray"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Illustration Container (Flexible Height) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/illustrationCard"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#F8FAFC"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/textWrapper"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginBottom="8dp">
             
             <ImageView
                android:id="@+id/ivIllustration"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_waste_overboading"
                android:scaleType="centerCrop"
                /> 

        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- Bottom Section -->
    <LinearLayout
        android:id="@+id/bottomSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingBottom="40dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Bottom Pagination (Step 3 of 6 + Progress Bar) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp">

            <!-- Progress Bar -->
            <FrameLayout
                android:layout_width="128dp"
                android:layout_height="6dp"
                android:layout_marginBottom="8dp">
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/dot_inactive"
                    android:backgroundTint="@color/gray_100"/>
                
                <View
                    android:layout_width="96dp" 
                    android:layout_height="match_parent"
                    android:background="@drawable/dot_active" 
                    android:backgroundTint="@color/primaryColor"/> <!-- 3/4 filled for 3/4? HTML says 3 of 4. I'll stick to 3/4 fill here. -->
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_step_3_indicator"
                android:textStyle="bold"
                android:textColor="@color/gray_500"
                android:textSize="12sp"
                android:letterSpacing="0.1"
                android:textAllCaps="true"/>

        </LinearLayout>

        <!-- Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnEnableReminders"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/enable_reminders"
            android:textSize="18sp"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:background="@drawable/bg_button_primary"
            android:textAllCaps="false"
            android:drawableEnd="@drawable/ic_arrow_forward"
            android:drawableTint="@color/white"
            android:paddingHorizontal="24dp"
            android:elevation="8dp"
            android:stateListAnimator="@null"
            />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
