<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="#F9FAFB"
    app:cardCornerRadius="6dp"
    app:cardElevation="0dp"
    app:strokeColor="#EEEEEE"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Item Image/Icon -->
        <FrameLayout
            android:id="@+id/imageContainer"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/bg_rounded_gray"
            android:foreground="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:id="@+id/itemImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="@string/item_image"
                android:visibility="gone"/>

            <ImageView
                android:id="@+id/placeholderIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_package"
                app:tint="@color/text_secondary"/>
        </FrameLayout>

        <!-- Item Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Title and Status -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/itemTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#111827"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="Silver ring with blue stone"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/statusChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Open"
                    android:textAllCaps="true"
                    android:textSize="12sp"
                    app:chipBackgroundColor="@color/status_open"
                    app:chipMinHeight="24dp"
                    app:chipStrokeWidth="0dp"
                    app:rippleColor="@null"/>
            </LinearLayout>

            <!-- Category and Date -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <com.google.android.material.chip.Chip
                    android:id="@+id/categoryChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Accessories"
                    android:textColor="#374151"
                    android:textSize="12sp"
                    app:chipBackgroundColor="@color/chip_background"
                    app:chipMinHeight="20dp"
                    app:chipStrokeWidth="0dp"
                    app:rippleColor="@null"/>

                <TextView
                    android:id="@+id/itemDateTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="12/10/2025, 2:17:19 PM - Railway station"/>
            </LinearLayout>

            <!-- Description -->
            <TextView
                android:id="@+id/itemDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#9CA3AF"
                android:textSize="14sp"
                tools:text="It is a diamond ring with a blue stone in the center. Found near the main entrance."/>

            <!-- Contact Section -->
            <LinearLayout
                android:id="@+id/contactSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Contact"
                    android:textColor="#6B7280"
                    android:textSize="12sp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/contactName"
                        style="@style/TextAppearance.AppCompat.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#2563EB"
                        android:textStyle="bold"
                        tools:text="RudranshGawande"/>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="12dp"
                        android:layout_marginHorizontal="8dp"
                        android:background="@color/divider"/>

                    <TextView
                        android:id="@+id/contactEmail"
                        style="@style/TextAppearance.AppCompat.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#2563EB"
                        tools:text="rudranshgawande007@gmail.com"/>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="12dp"
                        android:layout_marginHorizontal="8dp"
                        android:background="@color/divider"/>

                    <TextView
                        android:id="@+id/contactPhone"
                        style="@style/TextAppearance.AppCompat.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#2563EB"
                        tools:text="1234567890"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">

            <!-- Status Dropdown -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/statusButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginBottom="4dp"
                android:paddingHorizontal="8dp"
                android:text="Change status"
                android:textAllCaps="false"
                android:textSize="10sp"
                android:textColor="#4B5563"
                app:backgroundTint="#E5E7EB"
                app:icon="@drawable/ic_arrow_drop_down"
                app:iconGravity="end"
                app:iconPadding="0dp"
                app:iconSize="16dp"/>

            <!-- Delete Button -->
            <ImageButton
                android:id="@+id/deleteButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/delete"
                android:padding="6dp"
                android:src="@drawable/ic_delete"
                app:tint="#EF4444"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
