<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.Toolbar
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/topBar"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:background="@color/white"
    android:paddingStart="16dp"
    android:paddingEnd="4dp"
    android:contentInsetStart="0dp"
    android:contentInsetLeft="0dp"
    android:contentInsetStartWithNavigation="0dp"
    android:elevation="2dp"
    android:theme="@style/ThemeOverlay.AppCompat.Light">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Left logo + text -->
        <LinearLayout
            android:id="@+id/brandGroup"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="start|center_vertical"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:focusable="true"
            android:clickable="true"
            android:contentDescription="@string/aria_go_home"
            android:importantForAccessibility="yes">

            <!-- Logo container with gradient -->
            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="12dp">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:src="@drawable/logo"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no" />
            </FrameLayout>

            <!-- Title and subtitle -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/brandTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/brand_title"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/brandSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/brand_subtitle"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false" />
            </LinearLayout>
        </LinearLayout>

        <!-- Right side controls -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="end|center_vertical"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/themeToggle"
                style="?attr/borderlessButtonStyle"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_dark_mode"
                android:contentDescription="Toggle Theme"
                android:background="@android:color/transparent"
                app:tint="@color/iconTint"
                android:focusable="true"
                android:importantForAccessibility="yes" />

            <ImageButton
                android:id="@+id/buttonMenu"
                style="?attr/borderlessButtonStyle"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_menu"
                android:contentDescription="@string/aria_open_menu"
                android:background="@android:color/transparent"
                app:tint="@color/iconTint"
                android:focusable="true"
                android:importantForAccessibility="yes" />
        </LinearLayout>

        <!-- Subtle bottom divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_gravity="bottom"
            android:background="@color/card_border" />

    </FrameLayout>

</androidx.appcompat.widget.Toolbar>
