<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f1f3f5">

    <!-- Map Fragment -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Left Back Button -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardBack"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="48dp"
        android:layout_marginStart="20dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@android:color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_arrow_back"
            android:scaleType="centerInside"
            android:background="?attr/selectableItemBackground"
            app:tint="#111418"/>
    </androidx.cardview.widget.CardView>

    <!-- Top Search Bar -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardSearch"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginTop="48dp"
        android:layout_marginEnd="20dp"
        android:layout_marginStart="12dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@android:color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/cardBack"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_search"
                app:tint="#9ca3af"/>

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="Search for a street or area..."
                android:paddingHorizontal="8dp"
                android:textColor="#111418"
                android:textColorHint="#9ca3af"
                android:textSize="14sp"
                android:maxLines="1"
                android:inputType="text" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>
    
    <!-- Suggestion List -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardSuggestions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="@android:color/white"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/cardSearch"
        app:layout_constraintStart_toStartOf="@id/cardSearch"
        app:layout_constraintEnd_toEndOf="@id/cardSearch">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSuggestions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="vertical"
            android:overScrollMode="ifContentScrolls"/>
    </androidx.cardview.widget.CardView>

    <!-- Map Controls (Right Side) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/cardBottom"
        android:layout_marginBottom="24dp">
        
        <androidx.cardview.widget.CardView
            android:id="@+id/btnZoomIn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@android:color/white"
            android:layout_marginBottom="12dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_add"
                android:scaleType="centerInside"
                android:background="?attr/selectableItemBackground"
                app:tint="#4B5563"/> 
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/btnZoomOut"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@android:color/white"
            android:layout_marginBottom="12dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_remove"
                android:scaleType="centerInside"
                android:background="?attr/selectableItemBackground"
                app:tint="#4B5563"/>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/fabMyLocation"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@android:color/white">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_my_location"
                android:scaleType="centerInside"
                android:background="?attr/selectableItemBackground"
                app:tint="#2b8cee"/>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <!-- Center Marker (Visual) -->
     <ImageView
        android:id="@+id/ivCenterMarkerShadow"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:src="@drawable/bg_circle_shape"
        app:tint="#33000000"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" 
        android:translationY="2dp"/>
        
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:translationY="-24dp">
        
        <!-- Big Location Icon -->
        <View
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_circle_shape"
            android:backgroundTint="#2b8cee"
            android:layout_gravity="center"
            android:elevation="6dp"/>
            
        <View
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_circle_shape"
            android:backgroundTint="#ffffff"
            android:layout_gravity="center"
            android:elevation="6dp"/>
            
        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_location_on_filled"
            app:tint="#2b8cee"
            android:layout_gravity="center"
            android:elevation="6dp"/>

        <!-- Radius Badge (Dynamic) -->
        <TextView
            android:id="@+id/tvRadiusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="15km Radius"
            android:background="@drawable/bg_badge_primary"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:layout_gravity="top|end"
            android:translationX="40dp"
            android:translationY="-10dp"
            android:elevation="8dp"
            android:visibility="gone"/>
            
    </FrameLayout>


    <!-- Bottom Details Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="24dp"
        app:cardCornerRadius="32dp"
        app:cardElevation="16dp"
        app:cardBackgroundColor="@android:color/white"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="top">

                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_rounded_16dp"
                    android:backgroundTint="#F8F9FA">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_map_outline"
                        android:layout_gravity="center"
                        app:tint="#2b8cee"/>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SELECTED AREA"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#9CA3AF"
                        android:letterSpacing="0.1"/>

                    <TextView
                        android:id="@+id/tvSelectedAddressTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Canal St &amp; Broadway"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#111418"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:layout_marginTop="2dp"/>

                    <TextView
                        android:id="@+id/tvSelectedAddressSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Lower Manhattan, New York, NY 10013"
                        android:textSize="13sp"
                        android:textColor="#6B7280"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirmLocation"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:text="Confirm Location"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:backgroundTint="#2b8cee"
                app:cornerRadius="16dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
