<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:paddingHorizontal="24dp">

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toTopOf="parent">

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btnSkip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Skip"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="@color/gray_500"
            android:padding="8dp"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <!-- Main Content -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/bottomSection"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- Illustration Container -->
            <!-- Aspect Ratio 1:1 (Square) per HTML "aspect-square" -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#F8FAFC" 
                android:layout_marginBottom="24dp">
                <!-- Helper View for Aspect Ratio -->
                 <!-- Actually CardView needs strict height in LinearLayout if weight used properly or ConstraintLayout ratio -->
            </androidx.cardview.widget.CardView>
        </LinearLayout>
        
        <!-- Re-doing layout with Constraint for better Aspect Ratio control -->
         <androidx.cardview.widget.CardView
                android:id="@+id/illustrationCard"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintWidth_percent="0.9"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#F8FAFC" 
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/tvHeadline"
                android:layout_marginBottom="32dp"
                app:layout_constraintVertical_chainStyle="packed">

                <ImageView
                    android:id="@+id/ivIllustration"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_transport_overboarding" 
                    android:scaleType="centerCrop"/>
                    <!-- Placeholder, user should replace with ic_onboarding_transport -->
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tvHeadline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_step_2_headline"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="@color/onboarding_text_dark"
            android:gravity="center"
            android:layout_marginBottom="16dp"
            app:layout_constraintTop_toBottomOf="@id/illustrationCard"
            app:layout_constraintBottom_toTopOf="@id/tvDescription"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:fontFamily="sans-serif-black"/>

        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_step_2_description"
            android:textSize="16sp"
            android:textColor="@color/onboarding_text_gray"
            android:gravity="center"
            app:layout_constraintWidth_max="320dp"
            app:layout_constraintTop_toBottomOf="@id/tvHeadline"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:lineSpacingMultiplier="1.2"
            android:fontFamily="sans-serif-medium"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Bottom Section -->
    <LinearLayout
        android:id="@+id/bottomSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingBottom="40dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Pagination Indicator (Step 2 of 6 + Progress Bar) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="32dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Step 2 "
                    android:textStyle="bold"
                    android:textColor="@color/onboarding_text_dark"
                    android:textSize="14sp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="of 6"
                    android:textColor="@color/onboarding_text_gray"
                    android:textSize="14sp"
                    android:textStyle="normal"/>
            </LinearLayout>

            <!-- Custom Progress Bar View implementation -->
            <FrameLayout
                android:layout_width="128dp"
                android:layout_height="6dp">
                <!-- Track -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/dot_inactive"
                    android:backgroundTint="@color/gray_100"/> <!-- Reusing shape or make new rounded rect -->
                
                <!-- Progress (1/3 width) -->
                 <View
                    android:layout_width="42dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/dot_active" 
                    android:backgroundTint="@color/onboarding_primary"/> 
                    <!-- dot_active is 32dp width fixed in shape, better to use flexible shape or just color with corner radius -->
            </FrameLayout>

        </LinearLayout>


        <!-- Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnNextStep"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/next_step"
            android:textSize="18sp"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:background="@drawable/bg_button_primary"
            android:textAllCaps="false"
            android:drawableEnd="@drawable/ic_arrow_forward"
            android:drawableTint="@color/white"
            android:paddingHorizontal="24dp"
            android:elevation="8dp"
            android:stateListAnimator="@null"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
