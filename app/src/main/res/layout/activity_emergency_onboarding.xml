<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:paddingHorizontal="24dp">

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Progress Dots (Added back to match Onboarding3 style reference if desired, or keep empty if strict to image. 
             User said "Take reference... for ratios and size".
             I will keep the Step 4 Image's "Skip" at top right, but using layout params from Step 3 for consistency.) -->

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btnSkip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Skip"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="@color/gray_500"
            android:padding="8dp"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/bottomSection"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="24dp">

            <!-- Illustration Container: 4:3 Ratio matching Onboarding Step 3 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/illustrationCard"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="4:3"
                app:layout_constraintWidth_percent="1.0"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#F8FAFC"
                android:layout_marginTop="130dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">
                 
                 <!-- Inner Content -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    
                    <!-- Pulse Circle Background (Adapted to 4:3) -->
                    <View
                        android:layout_width="200dp"
                        android:layout_height="200dp"
                        android:layout_gravity="center"
                        android:background="@drawable/circle_primary"
                        android:alpha="0.1"/>

                    <ImageView
                        android:id="@+id/ivIllustration"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_emergency_overboarding"
                        android:scaleType="centerCrop"
                        /> 

                    <!-- Shield Icon Badge -->
                     <androidx.cardview.widget.CardView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        app:cardCornerRadius="28dp"
                        app:cardElevation="8dp"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="16dp">
                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_shield"
                            android:layout_gravity="center"
                            app:tint="@color/primaryColor"/>
                     </androidx.cardview.widget.CardView>
                </FrameLayout>

            </androidx.cardview.widget.CardView>

            <!-- Text Content -->
            <!-- No Subtitle in Step 4 Strings, but to match spacing structure of Step 3, we position Headline below Card -->
            
            <TextView
                android:id="@+id/tvHeadline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_step_4_headline"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/onboarding_text_dark"
                android:gravity="center"
                 android:layout_marginTop="24dp"
                android:layout_marginBottom="16dp"
                android:fontFamily="sans-serif-black"
                app:layout_constraintTop_toBottomOf="@id/illustrationCard"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <TextView
                android:id="@+id/tvDescription"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_step_4_description"
                android:textSize="16sp"
                android:layout_marginTop="12dp"
                android:textColor="@color/onboarding_text_gray"
                android:gravity="center"
                app:layout_constraintWidth_max="300dp"
                app:layout_constraintTop_toBottomOf="@id/tvHeadline"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:lineSpacingMultiplier="1.2"
                android:fontFamily="sans-serif-medium"/>
            
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>


    <!-- Bottom Section -->
    <LinearLayout
        android:id="@+id/bottomSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingBottom="40dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Pagination Indicator (Segmented from Step 4 requirement) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="32dp">

             <!-- Custom Progress Bar -->
             <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical">
                
                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/dot_inactive"
                    android:layout_marginEnd="8dp"/>
                
                <View
                    android:layout_width="32dp"
                    android:layout_height="8dp"
                    android:background="@drawable/dot_active"
                    android:layout_marginEnd="8dp"/>
                
                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/dot_inactive"
                    android:layout_marginEnd="8dp"/>
                
                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/dot_inactive"/>

             </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_step_4_indicator"
                android:textStyle="bold"
                android:textColor="@color/gray_500"
                android:textSize="14sp"/>

        </LinearLayout>

        <!-- Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnNext"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/next"
            android:textSize="18sp"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:background="@drawable/bg_button_primary"
            android:textAllCaps="false"
            android:drawableEnd="@drawable/ic_arrow_forward"
            android:drawableTint="@color/white"
            android:paddingHorizontal="24dp"
            android:elevation="8dp"
            android:stateListAnimator="@null"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
