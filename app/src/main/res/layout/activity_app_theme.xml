<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_theme_bg"
    android:fitsSystemWindows="true"
    tools:context=".AppThemeActivity">

    <!-- Top App Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/app_theme_surface"
        android:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/app_theme_text_primary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/navigation_drawer_close"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="56dp" 
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/app_theme_title"
            android:textColor="@color/app_theme_text_primary"
            android:textSize="18sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnBack"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/app_theme_divider"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scrollbars="none"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:paddingHorizontal="4dp"
                android:text="@string/app_theme_description"
                android:textColor="@color/app_theme_text_secondary"
                android:textSize="16sp" />

            <!-- Options Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/app_theme_surface"
                app:cardCornerRadius="32dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- System Default -->
                    <LinearLayout
                        android:id="@+id/optionSystem"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="24dp">

                        <FrameLayout
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_rounded_20dp"
                            android:backgroundTint="@color/app_theme_icon_bg_system">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_theme_system"
                                app:tint="@color/gray_700" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="20dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/theme_system_default"
                                android:textColor="@color/app_theme_text_primary"
                                android:textSize="18sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/theme_system_desc"
                                android:textColor="@color/app_theme_text_secondary"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/checkSystem"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_check_circle_filled"
                            app:tint="@color/theme_selected_blue" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/app_theme_divider" />

                    <!-- Light -->
                    <LinearLayout
                        android:id="@+id/optionLight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="24dp">

                        <FrameLayout
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_rounded_20dp"
                            android:backgroundTint="@color/app_theme_icon_bg_light">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_light_mode"
                                app:tint="@color/theme_sun_yellow" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="20dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/theme_light"
                                android:textColor="@color/app_theme_text_primary"
                                android:textSize="18sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/theme_light_desc"
                                android:textColor="@color/app_theme_text_secondary"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/checkLight"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_radio_unchecked"
                            app:tint="@color/gray_300" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/app_theme_divider" />

                    <!-- Dark -->
                    <LinearLayout
                        android:id="@+id/optionDark"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="24dp">

                        <FrameLayout
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_rounded_20dp"
                            android:backgroundTint="@color/app_theme_icon_bg_dark">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_dark_mode"
                                app:tint="@color/theme_moon_blue" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="20dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/theme_dark"
                                android:textColor="@color/app_theme_text_primary"
                                android:textSize="18sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/theme_dark_desc"
                                android:textColor="@color/app_theme_text_secondary"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/checkDark"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_radio_unchecked"
                            app:tint="@color/gray_300" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Preview Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.05"
                android:text="@string/theme_preview"
                android:textColor="@color/app_theme_text_secondary"
                android:textSize="14sp"
                android:textAllCaps="true" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                     <!-- Rethink Mockup Wrapper -->
                     <!-- Use CardView for easy border + radius + elevation -->
                     <androidx.cardview.widget.CardView
                        android:layout_width="160dp"
                        android:layout_height="284dp"
                        android:layout_marginEnd="24dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="4dp"
                        app:cardBackgroundColor="@color/gray_200"> <!-- Border Color -->
                        
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_margin="4dp"
                            android:background="@color/white"
                            android:orientation="vertical">
                            
                            <!-- Mock Header -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="24dp"
                                android:gravity="center"
                                android:orientation="horizontal">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/connecto_caps"
                                    android:textSize="6sp"
                                    android:textColor="@color/gray_400"
                                    android:textStyle="bold"/>
                            </LinearLayout>
                            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/gray_100"/>
                            
                            <!-- Mock Content -->
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
                                <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
                                    <View android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/circle_gray"/>
                                    <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="8dp">
                                         <View android:layout_width="100dp" android:layout_height="8dp" android:background="@drawable/bg_rounded_gray" android:backgroundTint="@color/gray_200"/>
                                         <View android:layout_width="60dp" android:layout_height="6dp" android:layout_marginTop="4dp" android:background="@drawable/bg_rounded_gray" android:backgroundTint="@color/gray_200"/>
                                    </LinearLayout>
                                </LinearLayout>
                                <View android:layout_width="match_parent" android:layout_height="96dp" android:layout_marginTop="12dp" android:background="@drawable/bg_rounded_12dp" android:backgroundTint="@color/gray_200"/>
                                <View android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="16dp" android:background="@drawable/bg_rounded_12dp" android:backgroundTint="@color/white" android:elevation="1dp" />
                                
                                <!-- Label inside is tricky, mocking shadows is hard -->
                            </LinearLayout>
                             <View android:layout_weight="1" android:layout_width="match_parent" android:layout_height="0dp"/>
                             <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/theme_preview_light" android:textSize="10sp" android:gravity="center" android:textColor="@color/gray_800" android:padding="8dp" android:background="#F0FFFFFF"/>
                        </LinearLayout>
                     </androidx.cardview.widget.CardView>


                    <!-- Dark Mode Preview Mockup -->
                     <androidx.cardview.widget.CardView
                        android:layout_width="160dp"
                        android:layout_height="284dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="4dp"
                        app:cardBackgroundColor="@color/gray_700"> <!-- Border Color -->
                        
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_margin="4dp"
                            android:background="@color/theme_bg_dark" 
                            android:orientation="vertical">
                            
                            <!-- Mock Header -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="24dp"
                                android:gravity="center"
                                android:background="#1a2632"
                                android:orientation="horizontal">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/connecto_caps"
                                    android:textSize="6sp"
                                    android:textColor="@color/gray_400"
                                    android:textStyle="bold"/>
                            </LinearLayout>
                            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#333"/>
                            
                            <!-- Mock Content -->
                             <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
                                <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
                                    <View android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/circle_gray" android:backgroundTint="#1a2632"/>
                                    <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="8dp">
                                         <View android:layout_width="100dp" android:layout_height="8dp" android:background="@drawable/bg_rounded_gray" android:backgroundTint="#1a2632"/>
                                         <View android:layout_width="60dp" android:layout_height="6dp" android:layout_marginTop="4dp" android:background="@drawable/bg_rounded_gray" android:backgroundTint="#1a2632"/>
                                    </LinearLayout>
                                </LinearLayout>
                                <View android:layout_width="match_parent" android:layout_height="96dp" android:layout_marginTop="12dp" android:background="@drawable/bg_rounded_12dp" android:backgroundTint="#1a2632"/>
                                <View android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="16dp" android:background="@drawable/bg_rounded_12dp" android:backgroundTint="#1a2632" />
                            </LinearLayout>
                             <View android:layout_weight="1" android:layout_width="match_parent" android:layout_height="0dp"/>
                             <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/theme_preview_dark" android:textSize="10sp" android:gravity="center" android:textColor="@color/gray_200" android:padding="8dp" android:background="#CC1a2632"/>

                        </LinearLayout>
                     </androidx.cardview.widget.CardView>

                </LinearLayout>

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
