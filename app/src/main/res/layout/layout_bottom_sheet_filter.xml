<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:paddingBottom="16dp">

    <!-- Handle Bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:background="#E0E0E0"
        android:backgroundTint="#E5E7EB"/>

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:paddingVertical="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Filter Items"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/home_text_main" />

        <ImageView
            android:id="@+id/btnCloseFilter"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_close_small"
            app:tint="@color/home_text_secondary" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingBottom="24dp">

            <!-- Category Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CATEGORY"
                android:textSize="12sp"
                android:letterSpacing="0.05"
                android:textStyle="bold"
                android:textColor="@color/home_text_main"
                android:layout_marginBottom="12dp"/>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="2"
                android:alignmentMode="alignBounds">

                <!-- Electronics -->
                <LinearLayout
                    android:id="@+id/filterCatElectronics"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_filter_option_selected"
                    android:padding="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivCheckElectronics"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_check_circle_filled"
                        app:tint="@color/primary"
                        android:layout_marginEnd="8dp"/>

                    <TextView
                        android:id="@+id/tvCatElectronics"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Electronics"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/home_text_main"/>
                </LinearLayout>

                <!-- Personal -->
                <LinearLayout
                    android:id="@+id/filterCatPersonal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="8dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_filter_option_unselected"
                    android:padding="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivCheckPersonal"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_circle_outline_gray"
                        app:tint="#D1D5DB"
                        android:layout_marginEnd="8dp"/>

                    <TextView
                        android:id="@+id/tvCatPersonal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Personal"
                        android:textSize="14sp"
                        android:textColor="@color/home_text_secondary"/>
                </LinearLayout>

                <!-- Pets -->
                <LinearLayout
                    android:id="@+id/filterCatPets"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_filter_option_unselected"
                    android:padding="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivCheckPets"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_circle_outline_gray"
                        app:tint="#D1D5DB"
                        android:layout_marginEnd="8dp"/>

                    <TextView
                        android:id="@+id/tvCatPets"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pets"
                        android:textSize="14sp"
                        android:textColor="@color/home_text_secondary"/>
                </LinearLayout>

                <!-- Keys -->
                <LinearLayout
                    android:id="@+id/filterCatKeys"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_filter_option_unselected"
                    android:padding="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivCheckKeys"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_circle_outline_gray"
                        app:tint="#D1D5DB"
                        android:layout_marginEnd="8dp"/>

                    <TextView
                        android:id="@+id/tvCatKeys"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Keys"
                        android:textSize="14sp"
                        android:textColor="@color/home_text_secondary"/>
                </LinearLayout>
            </GridLayout>

            <!-- Status Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STATUS"
                android:textSize="12sp"
                android:letterSpacing="0.05"
                android:textStyle="bold"
                android:textColor="@color/home_text_main"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_segment"
                android:padding="4dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnStatusOpen"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Open"
                    android:gravity="center"
                    android:paddingVertical="8dp"
                    android:background="@drawable/bg_status_selected"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:elevation="1dp"
                    android:textColor="@color/home_text_main"/>

                <TextView
                    android:id="@+id/btnStatusResolved"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Resolved"
                    android:gravity="center"
                    android:paddingVertical="8dp"
                    android:textSize="14sp"
                    android:textColor="@color/home_text_secondary"/>

                <TextView
                    android:id="@+id/btnStatusAll"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="All"
                    android:gravity="center"
                    android:paddingVertical="8dp"
                    android:textSize="14sp"
                    android:textColor="@color/home_text_secondary"/>
            </LinearLayout>

            <!-- Date Posted Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DATE POSTED"
                android:textSize="12sp"
                android:letterSpacing="0.05"
                android:textStyle="bold"
                android:textColor="@color/home_text_main"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"/>

            <RadioGroup
                android:id="@+id/rgDatePosted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/rbLast24"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Last 24 hours"
                    android:textSize="14sp"
                    android:textColor="@color/home_text_secondary"
                    android:layoutDirection="rtl"
                    android:paddingVertical="12dp"
                    android:buttonTint="@color/primary"/>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F3F4F6"/>

                <RadioButton
                    android:id="@+id/rbLastWeek"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Last week"
                    android:textSize="14sp"
                    android:textColor="@color/home_text_main"
                    android:checked="true"
                    android:layoutDirection="rtl"
                    android:paddingVertical="12dp"
                    android:buttonTint="@color/primary"/>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F3F4F6"/>

                <RadioButton
                    android:id="@+id/rbLastMonth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Last month"
                    android:textSize="14sp"
                    android:textColor="@color/home_text_secondary"
                    android:layoutDirection="rtl"
                    android:paddingVertical="12dp"
                    android:buttonTint="@color/primary"/>
            </RadioGroup>

            <!-- Proximity Section -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PROXIMITY"
                    android:textSize="12sp"
                    android:letterSpacing="0.05"
                    android:textStyle="bold"
                    android:textColor="@color/home_text_main"/>
                
                <TextView
                    android:id="@+id/tvProximityValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10 km"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>

            <SeekBar
                android:id="@+id/seekBarProximity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="50"
                android:progress="10"
                android:progressTint="@color/primary"
                android:thumbTint="@color/primary"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"/>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Current location"
                    android:textSize="12sp"
                    android:textColor="@color/gray_400"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="City wide"
                    android:layout_alignParentEnd="true"
                    android:textSize="12sp"
                    android:textColor="@color/gray_400"/>
            </RelativeLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Footer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingTop="16dp">

        <TextView
            android:id="@+id/btnClearAll"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="Clear All"
            android:gravity="center"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/home_text_secondary"
            android:background="@drawable/bg_tab_toggle"
            android:layout_marginEnd="12dp"
            android:clickable="true"
            android:focusable="true"/>

        <Button
            android:id="@+id/btnApplyFilters"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="2"
            android:text="Apply Filters"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:backgroundTint="@color/primary"
            app:cornerRadius="16dp"/>
    </LinearLayout>

</LinearLayout>
